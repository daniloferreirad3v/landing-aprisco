---
// Contato: canais vindos de site.ts. Sem formulário (o site não guarda dados).
import Pagina from '../layouts/Pagina.astro';
import Preencher from '../components/Preencher.astro';
import { site } from '../data/site';
import { montarTitulo } from '../lib/seo';

const title = montarTitulo('Contato');
const description =
  'Fale com o Seminário Teológico APRISCO: tire dúvidas sobre os cursos e a assinatura. Veja também onde resolver questões de pagamento e acesso.';
const { contato, redes } = site;
---
<Pagina title={title} description={description} h1="Fale com o APRISCO" breadcrumbs={[{ nome: 'Contato', href: '/contato' }]}>
  <p slot="intro">Tire suas dúvidas sobre os cursos e a assinatura antes de começar.</p>

  <section aria-labelledby="titulo-canais">
    <h2 id="titulo-canais">Canais de atendimento</h2>
    <address class="contato__canais">
      <ul>
        <li>
          WhatsApp:{' '}
          {contato.whatsapp ? <a href={`https://wa.me/${contato.whatsapp}`}>falar no WhatsApp</a> : <Preencher oque="WhatsApp" />}
        </li>
        <li>
          E-mail: {contato.email ? <a href={`mailto:${contato.email}`}>{contato.email}</a> : <Preencher oque="e-mail" />}
        </li>
        <li>
          Instagram: {redes.instagram ? <a href={redes.instagram}>perfil do APRISCO</a> : <Preencher oque="Instagram" />}
        </li>
      </ul>
    </address>
    <p>Horário de atendimento: {contato.horario || <Preencher oque="horário de atendimento" />}</p>
  </section>

  <section aria-labelledby="titulo-pagamento">
    <h2 id="titulo-pagamento">Pagamento, acesso e reembolso</h2>
    <p>
      A assinatura, o acesso à área de membros e os pedidos de reembolso são processados pela Kiwify, a plataforma
      onde ficam os cursos. As respostas mais comuns estão nas <a href="/#titulo-faq">perguntas frequentes</a>.
    </p>
  </section>
</Pagina>

<style>
  .contato__canais {
    font-style: normal;
  }
</style>
