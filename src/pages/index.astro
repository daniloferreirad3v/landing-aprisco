---
// Home: página de vendas da assinatura, em SINGLE PAGE (decisão do cliente, 2026-10-05).
// O menu rola até as seções: #cursos, #sobre, #duvidas. A seção de contato saiu a pedido do
// cliente (2026-10-06).
// As páginas de curso existem só como porta de entrada pelo Google (sem links daqui).
// Ordem: marca + promessa + produto (mural) na 1ª tela → por que escolher → problema
// (texto do cliente) → o que a assinatura inclui → vitrine dos cursos → como funciona → planos → dúvidas → fechamento.
// Outline: h1 → h2 por que escolher → h2 manifesto → h2 inclui → h2 cursos (h3 trilhas, h4 cursos) → h2 como funciona
// (h3 passos) → h2 planos (h3 planos) → h2 perguntas → h2 fechamento.
// Sem números inventados: contagens e preços vêm de cursos.ts/trilhas.ts.
// "Quem ensina" e "Depoimentos" só entram quando houver dados reais (PENDENCIAS.md).
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import MuralCapas from '../components/MuralCapas.astro';
import AssinaturaMarca from '../components/AssinaturaMarca.astro';
import CtaButton from '../components/CtaButton.astro';
import TrilhaSection from '../components/TrilhaSection.astro';
import Planos from '../components/Planos.astro';
import Faq from '../components/Faq.astro';
import { trilhas } from '../data/trilhas';
import { faqGeral } from '../data/faq';
import { montarTitulo } from '../lib/seo';

const title = montarTitulo('Seminário Teológico Online');
const description =
  'Estude teologia de maneira profunda e descomplicada. Cursos online de Bíblia, doutrina, família e vida cristã no Seminário Teológico APRISCO.';


// Texto enviado pelo cliente em 2026-10-06. A repetição de "A APRISCO" é dele, é figura
// de linguagem (anáfora): manter.
const porque = [
  'A APRISCO capacita cristãos bíblica e teologicamente para viverem uma vida relevante na sociedade.',
  'A APRISCO treina líderes teologicamente para lidarem com as dores desta geração.',
  'A APRISCO prepara pregadores que desejam pregar sermões cheios da Palavra e do Espírito.',
  'A APRISCO levanta cristãos que desejam amar e servir a Igreja de Cristo.',
];

// Textos enviados pelo cliente em 2026-10-06. O número de aulas ("+80") é dado factual
// do cliente: manter atualizado (ver PENDENCIAS.md).
const inclui = [
  {
    titulo: 'Todos os cursos do Catálogo',
    texto:
      'De Fundamentos da Fé à Teologia Sistemática, estude de maneira ampla a Palavra de Deus e seja capacitado. Já são +80 aulas disponíveis hoje!',
  },
  {
    titulo: 'Cursos Novos sem Custo extra',
    texto:
      'Acesso a todos os cursos novos acrescentados à plataforma sem nenhum adicional durante sua assinatura.',
  },
  {
    titulo: 'Estudo On-line',
    texto:
      'As aulas ficam disponíveis na sua área de membros e você pode acessar a qualquer hora e de qualquer lugar do mundo!',
  },
  {
    titulo: 'Assinatura Simples',
    texto: 'Clique, assine, assista e cancele quando quiser.',
  },
];
---
<Base title={title} description={description}>
  <Hero titulo="Estude teologia de maneira profunda e descomplicada.">
    <AssinaturaMarca slot="marca" />
    <p>Se aprofunde no Conhecimento de Deus, Capacite-se para viver seu Chamado e Sirva com Excelência a Igreja de Cristo.</p>
    <MuralCapas slot="visual" />
  </Hero>

  <section class="faixa porque" aria-labelledby="titulo-porque">
    <div class="container secao porque__grade">
      <h2 id="titulo-porque" class="porque__titulo revela">Por que escolher a APRISCO?</h2>
      <ul class="porque__lista lista-limpa">
        {porque.map((item, i) => (
          <li class="porque__item revela" style={`--revela-i: ${i}`}>{item}</li>
        ))}
      </ul>
      <div class="porque__acao">
        <CtaButton variante="suave">QUERO COMEÇAR AGORA</CtaButton>
      </div>
    </div>
  </section>

  <section id="sobre" class="manifesto" aria-labelledby="titulo-manifesto">
    <div class="container secao manifesto__grade">
      <h2 id="titulo-manifesto" class="manifesto__titulo">
        <span class="manifesto__linha revela revela--linha">Uma fé rasa,</span>{' '}
        <span class="manifesto__linha revela revela--linha" style="--revela-i: 1">uma vida rasa.</span>
      </h2>
      <div class="manifesto__texto revela" style="--revela-i: 1">
        <p class="manifesto__pergunta">
          Teologia Clássica e Sólida aplicada aos dilemas da Atualidade. Aprenda a pregar a Bíblia para os dias de hoje!
        </p>
        <p>
          O Seminário Teológico APRISCO está comprometido com uma teologia bíblica que responde aos dilemas da
          sociedade hoje. Os cursos são preparados para formar em você uma Cosmovisão Cristã a partir do conhecimento
          de Deus!
        </p>
        <div class="manifesto__acao">
          <CtaButton variante="suave">QUERO COMEÇAR MEUS ESTUDOS AGORA</CtaButton>
        </div>
      </div>
    </div>
  </section>

  <section class="container secao" aria-labelledby="titulo-inclui">
    <h2 id="titulo-inclui" class="revela">O que a assinatura inclui</h2>
    <ul class="inclui lista-limpa">
      {inclui.map((item, i) => (
        <li class="inclui__item revela" style={`--revela-i: ${i}`}>
          <svg class="inclui__marca" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
            <path d="M4 12.5l5 5L20 6.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
          </svg>
          <div>
            <p class="inclui__titulo">{item.titulo}</p>
            <p class="inclui__texto">{item.texto}</p>
          </div>
        </li>
      ))}
    </ul>
    <div class="acao-meio">
      <CtaButton>ASSINAR AGORA</CtaButton>
    </div>
  </section>

  <section id="cursos" class="container secao vitrine" aria-labelledby="titulo-trilhas">
    <div class="vitrine__cabeca">
      <h2 id="titulo-trilhas" class="revela">Escolha por onde começar</h2>
      <p>
        Todos incluídos na assinatura.
      </p>
    </div>
    {trilhas.map((trilha) => <TrilhaSection trilha={trilha} nivel="h3" compacto link={false} emais />)}
  </section>

  <section class="faixa" aria-labelledby="titulo-como-funciona">
    <div class="container secao">
      <h2 id="titulo-como-funciona" class="revela">Como funciona</h2>
      <ol class="passos lista-limpa">
        <li class="revela">
          <h3>Clique em "ASSINAR AGORA"</h3>
          <p>Você vai direto para a página de pagamento.</p>
        </li>
        <li class="revela" style="--revela-i: 1">
          <h3>Finalize o pagamento</h3>
          <p>A compra é processada pela Kiwify, plataforma de hospedagem dos nossos cursos.</p>
        </li>
        <li class="revela" style="--revela-i: 2">
          <h3>Acesso à área de membros</h3>
          <p>
            Você receberá em seu e-mail acesso à nossa área de membros. Basta seguir o passo a passo. Se quiser
            melhorar a sua experiência, baixe o app da Kiwify e cadastre-se com o mesmo e-mail de compra do curso.
            O Seminário Teológico APRISCO estará lá dentro!
          </p>
        </li>
        <li class="revela" style="--revela-i: 3">
          <h3>Estude no seu Ritmo</h3>
          <p>Estude Teologia a qualquer hora e em qualquer lugar.</p>
        </li>
      </ol>
    </div>
  </section>

  <div class="container secao">
    <Planos />
  </div>

  <div id="duvidas" class="container secao">
    <Faq itens={faqGeral} titulo="Dúvidas antes de assinar" />
  </div>

  <section class="final" aria-labelledby="titulo-final">
    <div class="container secao final__conteudo">
      <img class="final__selo revela revela--cedo" src="/logo/cordeiro-selo-branco.svg" alt="" width="458" height="458" loading="lazy" />
      <h2 id="titulo-final" class="revela revela--cedo">Construa uma vida profunda a partir do conhecimento de Deus.</h2>
      <CtaButton>ASSINAR AGORA</CtaButton>
    </div>
  </section>

</Base>

<style>
  /* Manifesto: o problema, com as palavras do cliente */
  .manifesto {
    border-block: var(--fio) solid var(--cor-fio);
  }

  .manifesto__grade {
    display: grid;
    gap: var(--esp-6);
  }

  .manifesto__linha {
    display: block;
  }

  .manifesto__titulo {
    font-size: clamp(3rem, 1.5rem + 7vw, 7rem);
    max-width: 6.5em;
  }

  .manifesto__texto {
    display: grid;
    gap: var(--esp-4);
    align-content: start;
  }

  .manifesto__pergunta {
    font-size: var(--fs-h3);
    font-weight: var(--peso-forte);
    line-height: 1.35;
  }

  .manifesto__acao {
    margin-top: var(--esp-2);
  }

  .manifesto__texto p:not(.manifesto__pergunta) {
    color: var(--cor-texto-suave);
  }

  @media (min-width: 64rem) {
    /* texto da direita centralizado na altura do título grande */
    .manifesto__grade {
      grid-template-columns: 1.1fr 1fr;
      align-items: center;
      gap: var(--esp-8);
    }
  }

  /* O que inclui: lista com marca de check (informa o que está incluído) */
  .inclui {
    display: grid;
    gap: var(--esp-5) var(--esp-7);
    margin-top: var(--esp-6);
  }

  .inclui__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--esp-3);
  }

  .inclui__marca {
    color: var(--cor-destaque);
    margin-top: 0.15em;
  }

  .inclui__titulo {
    font-weight: var(--peso-forte);
  }

  .inclui__texto {
    margin-top: var(--esp-1);
    color: var(--cor-texto-suave);
    font-size: var(--fs-pequeno);
  }

  @media (min-width: 48rem) {
    .inclui {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .acao-meio {
    margin-top: var(--esp-7);
  }

  /* Por que escolher: título e CTA de um lado, as quatro promessas do outro. A litania
     ("A APRISCO...") já dá o ritmo da lista, então nada de fio, ícone ou card:
     o que organiza é o espaço e a coluna. */
  .porque__grade {
    display: grid;
    gap: var(--esp-6);
  }

  /* a seção abre logo abaixo do hero: o título entra num degrau menor que os outros
     h2, para a página não gritar duas vezes seguidas */
  .porque__titulo {
    font-size: var(--fs-h3);
    text-wrap: balance;
  }

  .porque__lista {
    display: grid;
    gap: var(--esp-5);
  }

  .porque__item {
    max-inline-size: 48ch;
    line-height: var(--lh-corpo);
    text-wrap: pretty;
  }

  /* No celular a ordem é a da leitura: título, promessas e só então o convite.
     No desktop, título e botão vão para a coluna da esquerda, ao lado das promessas. */
  @media (min-width: 64rem) {
    .porque__grade {
      grid-template-columns: minmax(16rem, 22rem) 1fr;
      grid-template-areas:
        'titulo lista'
        '.      acao';
      column-gap: var(--esp-8);
      row-gap: var(--esp-6);
    }

    /* o título acompanha o meio da lista; o botão fica logo abaixo dela, na mesma
       coluna do texto, para não ficar solto no vazio da esquerda */
    .porque__titulo {
      grid-area: titulo;
      align-self: center;
    }

    .porque__acao {
      grid-area: acao;
    }

    .porque__lista {
      grid-area: lista;
      gap: var(--esp-6);
    }
  }

  /* Vitrine */
  .vitrine {
    display: grid;
    gap: var(--esp-7);
  }

  .vitrine__cabeca p {
    margin-top: var(--esp-4);
    color: var(--cor-texto-suave);
  }

  /* Como funciona: faixa em superfície, passos numerados (sequência real) */
  .faixa {
    background: var(--cor-superficie);
  }

  .passos {
    display: grid;
    gap: var(--esp-6);
    margin-top: var(--esp-6);
    counter-reset: passo;
  }

  /* Cada passo: número à esquerda; título e texto empilhados à direita, colados no topo
     (sem isso, o passo é esticado e o espaço extra empurra o texto de forma desigual) */
  .passos li {
    counter-increment: passo;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    grid-template-rows: auto auto;
    align-content: start;
    column-gap: var(--esp-3);
    row-gap: var(--esp-2);
  }

  .passos li::before {
    content: counter(passo);
    grid-column: 1;
    grid-row: 1 / span 2;
    align-self: start;
    font-family: var(--fonte-display);
    font-size: var(--fs-h2);
    line-height: 1;
    color: var(--cor-destaque);
  }

  .passos h3 {
    grid-column: 2;
    font-size: var(--fs-h4);
  }

  .passos p {
    grid-column: 2;
    color: var(--cor-texto-suave);
    font-size: var(--fs-pequeno);
  }

  /* Tablet e desktop: 2 colunas, para o passo 3 (texto longo) não virar uma coluna
     estreita de muitas linhas ao lado de passos de 2 linhas.
     Subgrid: dentro de cada linha, títulos e textos começam na mesma altura. */
  @media (min-width: 48rem) {
    .passos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--esp-7);
      row-gap: var(--esp-6);
    }

    .passos li {
      grid-row: span 2;
      grid-template-rows: subgrid;
    }
  }

  /* Fechamento */
  .final {
    background: var(--cor-preto);
  }

  .final__conteudo {
    display: grid;
    justify-items: center;
    gap: var(--esp-5);
    text-align: center;
  }

  .final__selo {
    width: 4.5rem;
    height: 4.5rem;
  }

  .final__conteudo h2 {
    font-size: clamp(2.25rem, 1.25rem + 4vw, 4.5rem);
    max-width: 11em;
  }

  /* sem a linha de preço entre os dois, o botão ganha respiro próprio do título */
  .final__conteudo :global(.botao) {
    margin-top: var(--esp-4);
  }
</style>
