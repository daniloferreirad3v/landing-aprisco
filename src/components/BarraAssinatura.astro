---
// Barra fixa de assinatura, só no celular. Sem JavaScript:
// com suporte a animação ligada à rolagem, aparece depois da primeira tela;
// sem suporte, fica sempre visível (o conteúdo ganha espaço no fim para não ser coberto).
import CtaButton from './CtaButton.astro';
import { cursos, formatarReais, precoAPartirDe } from '../data/cursos';

interface Props {
  curso?: string;
}

const { curso } = Astro.props;
---
<aside class="barra" aria-label="Assinatura">
  <p class="barra__texto">
    <strong>{cursos.length} cursos</strong>
    <span>a partir de {formatarReais(precoAPartirDe)}/mês</span>
  </p>
  <CtaButton curso={curso}>Quero assinar</CtaButton>
</aside>

<style>
  .barra {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--esp-4);
    padding: var(--esp-3) var(--margem-lateral);
    padding-bottom: calc(var(--esp-3) + env(safe-area-inset-bottom));
    background: var(--cor-preto);
    border-top: var(--fio) solid var(--cor-fio);
  }

  .barra__texto {
    display: grid;
    line-height: 1.3;
    font-size: var(--fs-pequeno);
  }

  .barra__texto span {
    color: var(--cor-texto-suave);
  }

  .barra :global(.botao) {
    min-height: var(--alvo-toque);
    padding-inline: var(--esp-4);
  }

  /* Espaço para a barra não cobrir o rodapé */
  :global(body:has(.barra)) {
    padding-bottom: 4.75rem;
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .barra {
        animation: barra-aparece linear both;
        animation-timeline: scroll(root);
        animation-range: 0 90vh;
      }
    }
  }

  @keyframes barra-aparece {
    0%,
    70% {
      transform: translateY(110%);
      visibility: hidden;
    }
    100% {
      transform: translateY(0);
      visibility: visible;
    }
  }

  @media (min-width: 48rem) {
    .barra {
      display: none;
    }

    :global(body:has(.barra)) {
      padding-bottom: 0;
    }
  }
</style>
