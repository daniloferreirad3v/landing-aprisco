---
// Card de curso: capa + título com o único link do card + chamada.
// A área de clique cobre o card inteiro (a::after), sem aninhar links.
// A capa usa alt="" porque o nome do curso está logo abaixo em texto: repetir
// "Capa do curso X" faria o leitor de tela anunciar o nome duas vezes.
import { Image } from 'astro:assets';
import { urlDoCurso, type Curso } from '../data/cursos';

interface Props {
  curso: Curso;
  nivel?: 'h3' | 'h4';
  prioridade?: boolean; // true só para cards visíveis na primeira tela
  compacto?: boolean; // só capa e nome (vitrine da home); a chamada fica na página do curso
  link?: boolean; // false = só vitrine, sem clique (home single page)
}

const { curso, nivel = 'h3', prioridade = false, compacto = false, link = true } = Astro.props;
const Titulo = nivel;
---
<article class:list={['card', link && 'card--link']}>
  <div class="card__capa">
    {
      curso.capa ? (
        <Image
          src={curso.capa}
          alt=""
          widths={[240, 360, 480, 640]}
          sizes="(min-width: 64rem) 14rem, (min-width: 48rem) 28vw, 44vw"
          loading={prioridade ? 'eager' : 'lazy'}
          decoding="async"
          class="card__img"
        />
      ) : (
        <div class="card__sem-capa" aria-hidden="true">
          <span>{curso.nome}</span>
        </div>
      )
    }
  </div>
  <Titulo class="card__titulo">
    {link ? <a href={urlDoCurso(curso)}>{curso.nome}</a> : curso.nome}
  </Titulo>
  {!compacto && <p class="card__chamada">{curso.chamada}</p>}
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--esp-2);
  }

  .card__capa {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--raio);
    background: var(--cor-superficie);
    margin-bottom: var(--esp-2);
    transition: transform var(--duracao-rapida) var(--curva-saida);
  }

  /* Resposta ao mouse: a capa salta um pouco, como quem puxa o livro da estante.
     Vale também na home, onde o card não é link (decisão do single page). */
  .card:hover .card__capa,
  .card:focus-within .card__capa {
    transform: translateY(-6px);
  }

  /* Linha roxa sob a capa: citação da área de membros, aqui indicando seleção */
  .card__capa::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 3px;
    background: var(--cor-destaque);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duracao-rapida) ease;
  }

  .card--link:hover .card__capa::after,
  .card--link:focus-within .card__capa::after {
    transform: scaleX(1);
  }

  .card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__sem-capa {
    display: grid;
    place-items: center;
    height: 100%;
    padding: var(--esp-4);
    background: var(--cor-preto);
    border: var(--fio) solid var(--cor-fio);
    border-radius: var(--raio);
    font-family: var(--fonte-display);
    font-size: var(--fs-h2);
    text-transform: uppercase;
    text-align: center;
    line-height: var(--lh-display);
  }

  .card__titulo {
    font-size: var(--fs-h4);
  }

  .card__titulo a {
    text-decoration: none;
  }

  .card__titulo a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--raio);
  }

  .card__titulo a:focus-visible {
    outline: none;
  }

  .card__titulo a:focus-visible::after {
    outline: 2px solid var(--cor-destaque);
    outline-offset: 4px;
  }

  .card:hover .card__titulo a {
    color: var(--cor-texto);
  }

  .card__chamada {
    color: var(--cor-texto-suave);
    font-size: var(--fs-pequeno);
    line-height: 1.5;
  }
</style>
