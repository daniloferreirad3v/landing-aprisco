---
// O momento memorável do site: tipografia da marca sobre preto.
// Slots: "marca" = assinatura da escola acima do título; default = subtítulo; "acoes" = botões; "visual" = elemento à direita
// (na home, o mural de capas). Sem "visual", mostra o selo do cordeiro.
// Movimento: entrada do h1 junto com o visual, numa única sequência (desligada com movimento reduzido).
interface Props {
  titulo: string;
  id?: string;
}

const { titulo, id = 'titulo-hero' } = Astro.props;
const temVisual = Astro.slots.has('visual');
---
<section class:list={['hero', temVisual && 'hero--com-visual']} aria-labelledby={id}>
  <div class="container hero__grade">
    <div class="hero__texto">
      {Astro.slots.has('marca') && (
        <div class="hero__marca">
          <slot name="marca" />
        </div>
      )}
      <h1 id={id} class="hero__titulo">{titulo}</h1>
      <div class="hero__sub">
        <slot />
      </div>
      {Astro.slots.has('acoes') && (
        <div class="hero__acoes">
          <slot name="acoes" />
        </div>
      )}
    </div>
    {
      temVisual ? (
        <div class="hero__visual">
          <slot name="visual" />
        </div>
      ) : (
        <img class="hero__selo" src="/logo/cordeiro-selo-branco.svg" alt="" width="458" height="458" />
      )
    }
  </div>
</section>

<style>
  .hero {
    background: var(--cor-preto);
    padding-block: var(--esp-5) var(--espaco-secao);
    overflow: hidden;
  }

  .hero__grade {
    display: grid;
    gap: var(--esp-6);
  }

  /* O botão de assinar precisa aparecer sem rolar: título em 3 linhas
     ("ESTUDE TEOLOGIA DE / MANEIRA PROFUNDA E / DESCOMPLICADA.", ~8,3em a mais longa).
     Medida em em (não ch, que é estreito demais na Anton). */
  .hero__titulo {
    max-width: 8.6em;
    font-size: clamp(2rem, 9.4vw, 4.5rem);
    overflow-wrap: normal;
  }

  /* A assinatura identifica a escola; o h1 é a mensagem. Respiro claro entre os dois */
  .hero__marca {
    margin-bottom: var(--esp-4);
  }

  .hero__sub {
    margin-top: var(--esp-3);
    color: var(--cor-texto-suave);
    font-size: var(--fs-corpo);
    max-width: 34rem;
  }

  .hero__sub :global(p + p) {
    margin-top: var(--esp-3);
  }

  .hero__acoes {
    display: flex;
    flex-wrap: wrap;
    /* stretch: no desktop o bloco do preço ganha a altura do botão (ver index.astro) */
    align-items: stretch;
    gap: var(--esp-3) var(--esp-4);
    margin-top: var(--esp-5);
  }

  .hero__selo {
    width: 4.5rem;
    height: 4.5rem;
    order: -1;
  }

  @media (min-width: 48rem) {
    .hero {
      padding-top: var(--esp-7);
    }

    .hero__grade {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: var(--esp-7);
    }

    /* Botão do topo um pouco mais alto no desktop: o bloco do preço ao lado ganha a mesma
       altura e respiro entre o texto e os números (index.astro) */
    .hero__acoes :global(.botao) {
      min-height: 3.5rem;
    }

    .hero__selo {
      order: 0;
      width: clamp(8rem, 4rem + 8vw, 12rem);
      height: auto;
    }

    .hero--com-visual .hero__grade {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }

    /* Com o mural ao lado, o título divide a largura: tamanho limitado pela coluna */
    .hero--com-visual .hero__titulo {
      font-size: clamp(2.5rem, 4.6vw, 4.25rem);
    }
  }

  @media (min-width: 64rem) {
    .hero--com-visual {
      padding-block: var(--esp-5) var(--esp-7);
    }
  }

  /* Abertura orquestrada: assinatura → título → subtítulo → botão e preço, em cascata curta.
     Só posição e opacidade; com movimento reduzido, tudo aparece parado. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__marca,
    .hero__titulo,
    .hero__sub,
    .hero__acoes {
      animation: hero-entrada 700ms var(--curva-saida) both;
    }

    .hero__titulo {
      animation-delay: 90ms;
    }

    .hero__sub {
      animation-delay: 220ms;
    }

    .hero__acoes {
      animation-delay: 340ms;
    }
  }

  @keyframes hero-entrada {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  /* Telas grandes: o topo cresce com a largura E a altura da tela (o menor dos dois),
     para ocupar o espaço sem empurrar o botão para baixo da dobra */
  @media (min-width: 100rem) and (min-height: 50rem) {
    .hero--com-visual {
      padding-block: var(--esp-7) var(--esp-8);
    }

    .hero--com-visual .hero__titulo {
      font-size: clamp(4.25rem, min(5vw, 9.6vh), 7.5rem);
    }

    .hero__marca {
      margin-bottom: var(--esp-6);
    }

    .hero__sub {
      margin-top: var(--esp-5);
      max-width: 40rem;
      font-size: 1.25rem;
    }

    .hero__acoes {
      margin-top: var(--esp-6);
    }

    .hero__acoes :global(.botao) {
      min-height: 3.75rem;
      padding-inline: var(--esp-6);
      font-size: 1.1875rem;
    }
  }
</style>
