---
// Seção de assinatura (#assinatura). Destino de todos os botões "Assinar agora".
// Hierarquia (pedido do cliente, 2026-10-06): dois cards lado a lado, como no formato
// original — o anual é a oferta principal (card em destaque, ênfase na parcela) e o
// mensal volta a ter card próprio, em segundo plano.
// O preço à vista do anual aparece em letra menor. O total a prazo foi retirado do card a
// pedido do cliente (2026-10-05); continua no FAQ. Ver PENDENCIAS.md (regras de oferta parcelada).
// Valores e links vêm de cursos.ts (assinatura.planos).
import CtaButton from './CtaButton.astro';
import { formatarNumero, formatarReais, getPlano, ofertaDestaque } from '../data/cursos';

interface Props {
  titulo?: string;
  curso?: string; // slug, quando a seção aparece numa página de curso
  variante?: 'completa' | 'compacta';
}

const { titulo = 'Acesso a todos os cursos', curso, variante = 'completa' } = Astro.props;
const idTitulo = 'titulo-assinatura';

const mensal = getPlano('mensal');
const anual = getPlano('anual');
// "Melhor custo" só aparece se a parcela do anual for de fato menor que o mensal.
const melhorCusto = ofertaDestaque.parcela < mensal.valor;
---
<section id="assinatura" class:list={['planos', `planos--${variante}`]} aria-labelledby={idTitulo}>
  <div class="planos__cabeca">
    <h2 id={idTitulo} class="revela">{titulo}</h2>
    <p class="planos__intro">
      Uma assinatura, todos os cursos disponíveis do APRISCO e mais todos os cursos que forem acrescentados
      depois, sem nenhum custo adicional para você.
    </p>
  </div>

  <ul class="planos__lista lista-limpa">
    <li>
      <article class="plano plano--destaque revela revela--zoom" aria-labelledby="plano-anual">
        <div class="plano__topo">
          <h3 id="plano-anual" class="plano__nome">{anual.nome}</h3>
          {melhorCusto && <p class="plano__selo">Melhor custo</p>}
        </div>
        <p class="plano__preco">
          <span class="plano__periodo">{ofertaDestaque.quantidade}x de</span>
          <span class="plano__moeda">R$</span>
          <span class="plano__valor">{formatarNumero(ofertaDestaque.parcela)}</span>
        </p>
        <ul class="plano__detalhes lista-limpa">
          <li>ou {formatarReais(anual.valor)} à vista</li>
        </ul>
        <div class="plano__acao">
          <CtaButton plano="anual" curso={curso} largura="total">Assinar agora</CtaButton>
        </div>
      </article>
    </li>

    <li>
      <article class="plano plano--mensal revela revela--zoom" style="--revela-i: 1" aria-labelledby="plano-mensal">
        <div class="plano__topo">
          <h3 id="plano-mensal" class="plano__nome">{mensal.nome}</h3>
        </div>
        <p class="plano__preco">
          <span class="plano__moeda">R$</span>
          <span class="plano__valor">{formatarNumero(mensal.valor)}</span>
          <span class="plano__periodo">{mensal.periodo}</span>
        </p>
        <ul class="plano__detalhes lista-limpa">
          <li>Pagamento mês a mês, cancele quando quiser.</li>
        </ul>
        <div class="plano__acao">
          <CtaButton plano="mensal" curso={curso} largura="total" variante="secundario">ASSINAR</CtaButton>
        </div>
      </article>
    </li>
  </ul>

  <p class="planos__nota">Pagamento processado pela Kiwify. Você escolhe o plano e conclui a compra na página dela.</p>
</section>

<style>
  .planos__cabeca {
    display: grid;
    gap: var(--esp-4);
    margin-bottom: var(--esp-6);
  }

  .planos__intro {
    color: var(--cor-texto-suave);
  }

  .planos__lista {
    display: grid;
    gap: var(--esp-4);
  }

  .planos__lista > li {
    display: flex;
    max-inline-size: none; /* o <li> aqui é só a célula do grid */
  }

  .plano {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: var(--esp-5);
    border: var(--fio) solid var(--cor-fio);
    border-radius: var(--raio);
    background: var(--cor-superficie);
  }

  /* Plano anual: a oferta principal */
  .plano--destaque {
    border: 2px solid var(--cor-destaque);
    background: var(--cor-preto);
  }

  .plano__topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--esp-3);
  }

  .plano__nome {
    font-size: var(--fs-h4);
  }

  .plano__selo {
    padding: 0.2em 0.65em;
    border-radius: var(--raio);
    background: var(--cor-roxo);
    color: var(--cor-sobre-roxo);
    font-size: var(--fs-mini);
    font-weight: var(--peso-forte);
    white-space: nowrap;
  }

  .plano__preco {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--esp-2);
    margin-top: var(--esp-4);
  }

  .plano__moeda {
    font-family: var(--fonte-display);
    font-size: var(--fs-h4);
    line-height: 1;
  }

  .plano__valor {
    font-family: var(--fonte-display);
    font-size: clamp(2.5rem, 2rem + 2vw, 3.25rem);
    line-height: 1;
  }

  .plano__periodo {
    color: var(--cor-texto-suave);
    font-size: var(--fs-pequeno);
  }

  .plano__detalhes {
    display: grid;
    gap: var(--esp-1);
    margin-top: var(--esp-3);
    color: var(--cor-texto-suave);
    font-size: var(--fs-pequeno);
  }

  /* Os botões dos dois cards ficam na mesma linha de base */
  .plano__acao {
    margin-top: auto;
    padding-top: var(--esp-5);
  }

  .planos__nota {
    margin-top: var(--esp-5);
    color: var(--cor-texto-suave);
    font-size: var(--fs-mini);
  }

  .planos--compacta .planos__cabeca {
    margin-bottom: var(--esp-5);
  }

  /* Mensal: alternativa em segundo plano, card menor e mais discreto */
  .plano--mensal {
    padding: var(--esp-4) var(--esp-5);
  }

  .plano--mensal .plano__nome {
    font-size: var(--fs-pequeno);
    color: var(--cor-texto-suave);
  }

  .plano--mensal .plano__preco {
    margin-top: var(--esp-2);
  }

  .plano--mensal .plano__valor {
    font-size: 2.25rem;
  }

  .plano--mensal .plano__moeda {
    font-size: var(--fs-corpo);
  }

  .plano--mensal .plano__detalhes {
    margin-top: var(--esp-2);
    font-size: var(--fs-mini);
  }

  .plano--mensal .plano__acao {
    padding-top: var(--esp-4);
  }

  .plano--mensal .plano__acao :global(.botao) {
    min-height: var(--alvo-toque);
    font-size: var(--fs-pequeno);
  }

  /* Dois cards lado a lado: o anual bem maior, o mensal estreito e mais baixo,
     centrado na altura do anual */
  @media (min-width: 48rem) {
    /* o cabeçalho acompanha o eixo central dos cards */
    .planos__cabeca {
      justify-items: center;
      max-width: 58rem;
      margin-inline: auto;
      text-align: center;
    }

    .planos__lista {
      grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr);
      align-items: center;
      gap: var(--esp-5);
      max-width: 58rem;
      margin-inline: auto;
    }

    /* a nota acompanha o bloco de cards, para não ficar solta na borda esquerda */
    .planos__nota {
      max-width: 58rem;
      margin-inline: auto;
    }

    .plano--destaque {
      padding: var(--esp-7);
    }

    .plano--mensal {
      padding: var(--esp-5);
    }

    .plano--destaque .plano__nome {
      font-size: var(--fs-h3);
    }

    .plano--destaque .plano__valor {
      font-size: 6rem;
    }

    .plano--destaque .plano__moeda {
      font-size: var(--fs-h2);
    }

    .plano--destaque .plano__periodo {
      font-size: var(--fs-corpo);
    }

    .plano--destaque .plano__detalhes {
      font-size: var(--fs-corpo);
    }

    .plano--destaque .plano__acao :global(.botao) {
      min-height: 3.75rem;
      font-size: 1.1875rem;
    }
  }
</style>
