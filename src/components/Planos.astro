---
// Seção de assinatura (#assinatura). Destino de todos os botões "Assinar agora".
// Linguagem de assinatura única, sem "escolha de plano" (pedido do cliente, 2026-10-05):
// a oferta é o anual parcelado; o mensal aparece só como alternativa discreta.
// Valores e links vêm de cursos.ts (assinatura.planos).
// Hierarquia (pedido do cliente): o anual é a oferta principal, em card, com ênfase na
// parcela; o mensal aparece logo abaixo como alternativa discreta, em segundo plano.
// O preço à vista do anual aparece em letra menor. O total a prazo foi retirado do card a
// pedido do cliente (2026-10-05); continua no FAQ. Ver PENDENCIAS.md (regras de oferta parcelada).
import CtaButton from './CtaButton.astro';
import { formatarNumero, formatarReais, getPlano, ofertaDestaque } from '../data/cursos';

interface Props {
  titulo?: string;
  curso?: string; // slug, quando a seção aparece numa página de curso
  variante?: 'completa' | 'compacta';
}

const { titulo = 'Acesso a todos os cursos', curso, variante = 'completa' } = Astro.props;
const idTitulo = 'titulo-assinatura';

const mensal = getPlano('mensal');
const anual = getPlano('anual');
---
<section id="assinatura" class:list={['planos', `planos--${variante}`]} aria-labelledby={idTitulo}>
  <div class="planos__cabeca">
    <h2 id={idTitulo}>{titulo}</h2>
    <p class="planos__intro">
      Uma assinatura, todos os cursos do APRISCO, inclusive os que estão em preparação, assim que forem
      liberados.
    </p>
  </div>

  <article class="plano" aria-labelledby="oferta-assinatura">
    <div class="plano__topo">
      <h3 id="oferta-assinatura" class="plano__nome">Assinatura APRISCO</h3>
    </div>
    <p class="plano__preco">
      <span class="plano__periodo">{ofertaDestaque.quantidade}x de</span>
      <span class="plano__moeda">R$</span>
      <span class="plano__valor">{formatarNumero(ofertaDestaque.parcela)}</span>
    </p>
    <ul class="plano__detalhes lista-limpa">
      <li>ou {formatarReais(anual.valor)} à vista</li>
    </ul>
    <div class="plano__acao">
      <CtaButton plano="anual" curso={curso} largura="total">Assinar agora</CtaButton>
    </div>
  </article>

  <section class="alternativa" aria-labelledby="mes-a-mes">
    <h3 id="mes-a-mes" class="alternativa__titulo">Prefere pagar mês a mês?</h3>
    <p class="alternativa__texto">{formatarReais(mensal.valor)} {mensal.periodo}.</p>
    <CtaButton plano="mensal" curso={curso} variante="link">Assinar mês a mês</CtaButton>
  </section>

  <p class="planos__nota">Pagamento processado pela Kiwify. Ao clicar em "Assinar agora", você conclui a compra na página dela.</p>
</section>

<style>
  .planos__cabeca {
    display: grid;
    gap: var(--esp-4);
    margin-bottom: var(--esp-6);
  }

  .planos__intro {
    color: var(--cor-texto-suave);
  }

  /* Plano anual: o card principal */
  .plano {
    display: flex;
    flex-direction: column;
    max-width: 30rem;
    padding: var(--esp-5);
    border: 2px solid var(--cor-destaque);
    border-radius: var(--raio);
    background: var(--cor-preto);
  }

  .plano__topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--esp-3);
  }

  .plano__nome {
    font-size: var(--fs-h4);
  }

  .plano__selo {
    padding: 0.2em 0.65em;
    border-radius: var(--raio);
    background: var(--cor-destaque);
    color: var(--cor-sobre-destaque);
    font-size: var(--fs-mini);
    font-weight: var(--peso-forte);
    white-space: nowrap;
  }

  .plano__preco {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--esp-2);
    margin-top: var(--esp-4);
  }

  .plano__moeda {
    font-family: var(--fonte-display);
    font-size: var(--fs-h3);
    line-height: 1;
  }

  .plano__valor {
    font-family: var(--fonte-display);
    font-size: clamp(3rem, 2.25rem + 3vw, 4.25rem);
    line-height: 1;
  }

  .plano__periodo {
    color: var(--cor-texto-suave);
    font-size: var(--fs-pequeno);
  }

  .plano__detalhes {
    display: grid;
    gap: var(--esp-1);
    margin-top: var(--esp-3);
    color: var(--cor-texto-suave);
    font-size: var(--fs-pequeno);
  }

  .plano__acao {
    padding-top: var(--esp-5);
  }

  /* Plano mensal: alternativa em segundo plano, sem card */
  .alternativa {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: var(--esp-2);
    max-width: 30rem;
    margin-top: var(--esp-5);
    color: var(--cor-texto-suave);
    font-size: var(--fs-pequeno);
  }

  .alternativa__titulo {
    flex-basis: 100%;
    font-size: var(--fs-pequeno);
    font-weight: var(--peso-forte);
    color: var(--cor-texto);
  }

  .alternativa__texto {
    margin-top: var(--esp-1);
  }

  .planos__nota {
    margin-top: var(--esp-5);
    color: var(--cor-texto-suave);
    font-size: var(--fs-mini);
  }

  .planos--compacta .planos__cabeca {
    margin-bottom: var(--esp-5);
  }

  /* Desktop: card do anual maior e no centro; o resto da seção acompanha o eixo central */
  @media (min-width: 64rem) {
    .planos {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .planos__cabeca {
      justify-items: center;
    }

    .planos__intro {
      max-width: 40rem;
    }

    .plano {
      width: 100%;
      max-width: 36rem;
      padding: var(--esp-7);
      text-align: left;
    }

    .plano__nome {
      font-size: var(--fs-h3);
    }

    .plano__valor {
      font-size: 5.5rem;
    }

    .plano__moeda {
      font-size: var(--fs-h2);
    }

    .plano__periodo {
      font-size: var(--fs-corpo);
    }

    .plano__detalhes {
      font-size: var(--fs-corpo);
    }

    .plano__acao :global(.botao) {
      min-height: 3.75rem;
      font-size: 1.1875rem;
    }

    .alternativa {
      justify-content: center;
      max-width: 36rem;
    }
  }
</style>
