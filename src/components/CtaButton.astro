---
// ÚNICO componente que gera links de compra (CLAUDE.md, regra 4).
//
// - Com `plano`: abre o checkout daquele plano na Kiwify (URL vinda de cursos.ts).
// - Sem `plano` e sem `destino`: abre o checkout do plano ANUAL (pedido do cliente,
//   2026-10-06: todo botão de compra leva direto à assinatura anual).
// - Com `destino`: navegação interna (ex.: "#assinatura"), sem checkout.
//
// É um <a> (navegação), nunca <button>. Mesma aba, sem target="_blank".
// Os atributos data-cta/data-plano/data-curso servem para medir cliques (analytics).
import { getPlano, type PlanoId } from '../data/cursos';
import { site } from '../data/site';

interface Props {
  plano?: PlanoId;
  destino?: string;
  curso?: string; // slug, só para medição
  variante?: 'principal' | 'secundario' | 'suave' | 'link'; // suave = preenchido, menos intenso; link = opção discreta
  largura?: 'auto' | 'total';
}

const { plano: planoPedido, destino, curso, variante = 'principal', largura = 'auto' } = Astro.props;

const plano: PlanoId | undefined = planoPedido ?? (destino ? undefined : 'anual');
const link = plano ? getPlano(plano).linkKiwify : destino!;
const externo = Boolean(plano);
const indisponivel = plano !== undefined && link === '';
const alternativa = site.contato.whatsapp ? `https://wa.me/${site.contato.whatsapp}` : '';
const classes = ['botao', `botao--${variante}`, largura === 'total' && 'botao--total'];
---
{
  indisponivel ? (
    alternativa ? (
      <a class:list={classes} href={alternativa} data-cta="whatsapp" data-plano={plano}>
        Falar no WhatsApp
      </a>
    ) : (
      <span class:list={[...classes, 'botao--indisponivel']}>Assinatura indisponível no momento</span>
    )
  ) : (
    <a
      class:list={classes}
      href={link}
      rel={externo ? 'noopener' : undefined}
      data-cta={plano ? `checkout-${plano}` : 'ir-para-assinatura'}
      data-plano={plano}
      data-curso={curso}
    >
      <slot />
    </a>
  )
}

<style>
  .botao {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--esp-2);
    min-height: 3.25rem;
    padding: var(--esp-3) var(--esp-5);
    border: 2px solid transparent;
    border-radius: var(--raio);
    font-family: var(--fonte-texto);
    font-size: var(--fs-corpo);
    font-weight: var(--peso-forte);
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    transition:
      background-color var(--duracao-rapida) ease,
      color var(--duracao-rapida) ease,
      border-color var(--duracao-rapida) ease,
      transform var(--duracao-rapida) ease;
  }

  /* Resposta à ação: sobe levemente ao passar o mouse e "afunda" ao clicar */
  .botao--principal:hover,
  .botao--secundario:hover,
  .botao--suave:hover {
    transform: translateY(-2px);
  }

  .botao:active {
    transform: translateY(0) scale(0.98);
  }

  /* Roxo da marca com texto branco (11,5:1); ao passar o mouse, clareia para o roxo
     claro com texto escuro */
  .botao--principal {
    background: var(--cor-roxo);
    color: var(--cor-sobre-roxo);
  }

  .botao--principal:hover {
    background: var(--cor-destaque);
    color: var(--cor-sobre-roxo);
  }

  /* Brilho dos botões de compra (principal e suave): uma faixa larga de luz branca
     atravessa o botão devagar, de ponta a ponta, vai e volta, com uma pausa em cada
     lado. Passa POR TRÁS do texto (isolation + z-index negativo), para a palavra nunca
     perder contraste. Desligado com movimento reduzido. */
  .botao--principal,
  .botao--suave {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  @media (prefers-reduced-motion: no-preference) {
    .botao--principal::after,
    .botao--suave::after {
      content: '';
      position: absolute;
      inset-block: 0;
      left: 0;
      z-index: -1;
      width: 65%;
      background: linear-gradient(
        90deg,
        transparent,
        rgb(255 255 255 / 0.12) 20%,
        rgb(255 255 255 / 0.26) 40%,
        rgb(255 255 255 / 0.26) 60%,
        rgb(255 255 255 / 0.12) 80%,
        transparent
      );
      transform: translateX(-110%) skewX(-20deg);
      animation: botao-brilho 6.5s ease-in-out infinite alternate;
      pointer-events: none;
    }
  }

  @keyframes botao-brilho {
    0%,
    12% {
      transform: translateX(-110%) skewX(-20deg);
    }
    88%,
    100% {
      transform: translateX(200%) skewX(-20deg);
    }
  }

  .botao--secundario {
    background: transparent;
    border-color: var(--cor-texto);
    color: var(--cor-texto);
  }

  .botao--secundario:hover {
    border-color: var(--cor-destaque);
  }

  /* Preenchido, porém menos intenso: roxo mais fundo, texto branco (14,3:1).
     Ao passar o mouse, vai para o roxo cheio da marca.
     Texto em caixa-alta fica menor e mais espaçado para não "gritar". */
  .botao--suave {
    background: var(--cor-roxo-profundo);
    color: var(--cor-sobre-roxo);
    /* No celular ocupava quase a largura toda em 2 linhas: letra e respiro menores,
       mantendo a altura mínima de toque (44 px) */
    min-height: var(--alvo-toque);
    padding-inline: var(--esp-4);
    font-size: var(--fs-mini);
    letter-spacing: 0.03em;
  }

  .botao--suave:hover {
    background: var(--cor-roxo);
    color: var(--cor-sobre-roxo);
  }

  @media (min-width: 48rem) {
    .botao--suave {
      min-height: 3.25rem;
      padding-inline: var(--esp-5);
      font-size: var(--fs-pequeno);
      letter-spacing: 0.04em;
    }
  }

  /* Opção em segundo plano: aparência de link, mantendo área de toque de 44 px */
  .botao--link {
    min-height: var(--alvo-toque);
    padding: 0;
    border: 0;
    background: none;
    color: var(--cor-texto);
    font-size: var(--fs-pequeno);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .botao--link:hover {
    text-decoration-color: var(--cor-destaque);
    text-decoration-thickness: 2px;
  }

  .botao--total {
    width: 100%;
  }

  .botao--indisponivel {
    background: var(--cor-superficie);
    border-color: var(--cor-fio);
    color: var(--cor-texto-suave);
    cursor: not-allowed;
  }
</style>
