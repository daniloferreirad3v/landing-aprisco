---
// Mural de capas do hero: a biblioteca real do APRISCO em três colunas desencontradas,
// que se dissolvem no preto. Decorativo (os cursos estão listados em texto logo abaixo),
// por isso aria-hidden e alt="".
import { Image } from 'astro:assets';
import { getCurso } from '../data/cursos';

// 10 capas únicas: 5 de Teologia Sistemática no primeiro plano focal,
// complementadas por cursos fundamentais de Bíblia e Doutrina no segundo plano.
const slugs = [
  ['cristologia', 'antropologia-biblica', 'fundamentos-da-fe'],
  ['teontologia', 'pneumatologia', 'como-ler-a-sua-biblia', 'cosmovisao-crista'],
  ['escatologia', 'panorama-antigo-testamento', 'panorama-novo-testamento'],
];
const colunas = slugs.map((col) => col.map(getCurso).filter((c) => c.capa));
---
<div class="mural" aria-hidden="true">
  {colunas.map((coluna, i) => (
    <div class:list={['mural__coluna', `mural__coluna--${i + 1}`]}>
      {coluna.map((curso) => (
        <Image
          src={curso.capa!}
          alt=""
          widths={[160, 240, 320]}
          sizes="(min-width: 64rem) 11rem, (min-width: 48rem) 9rem, 30vw"
          loading="eager"
          decoding="async"
          class="mural__capa"
        />
      ))}
    </div>
  ))}
</div>

<style>
  .mural {
    --altura: 22rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--esp-3);
    height: var(--altura);
    overflow: hidden;
    /* as capas somem no preto em cima e embaixo, como uma estante no escuro */
    mask-image: linear-gradient(to bottom, transparent 0, #000 18%, #000 72%, transparent 100%);
  }

  .mural__coluna {
    display: grid;
    align-content: start;
    gap: var(--esp-3);
  }

  .mural__coluna--1 {
    transform: translateY(-12%);
  }

  .mural__coluna--2 {
    transform: translateY(-34%);
  }

  .mural__coluna--3 {
    transform: translateY(4%);
  }

  .mural__capa {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--raio);
  }

  @media (min-width: 48rem) {
    .mural {
      --altura: 34rem;
    }
  }

  @media (min-width: 64rem) {
    .mural {
      --altura: 40rem;
      gap: var(--esp-4);
    }

    .mural__coluna {
      gap: var(--esp-4);
    }
  }

  /* Único movimento orquestrado do hero: as colunas sobem devagar ao carregar */
  /* Depois de subir, as colunas derivam devagar em sentidos opostos, sem parar:
     a estante "respira". A subida usa `translate`; a deriva usa `transform`
     (que guarda o desencontro de cada coluna), então as duas não se anulam. */
  @media (prefers-reduced-motion: no-preference) {
    .mural__coluna--1 {
      animation:
        mural-sobe 1200ms var(--curva-saida) 200ms both,
        mural-deriva-1 26s ease-in-out 1400ms infinite alternate;
    }

    .mural__coluna--2 {
      animation:
        mural-sobe 1200ms var(--curva-saida) 320ms both,
        mural-deriva-2 30s ease-in-out 1500ms infinite alternate;
    }

    .mural__coluna--3 {
      animation:
        mural-sobe 1200ms var(--curva-saida) 440ms both,
        mural-deriva-3 28s ease-in-out 1600ms infinite alternate;
    }
  }

  @keyframes mural-deriva-1 {
    from {
      transform: translateY(-12%);
    }
    to {
      transform: translateY(-20%);
    }
  }

  @keyframes mural-deriva-2 {
    from {
      transform: translateY(-34%);
    }
    to {
      transform: translateY(-26%);
    }
  }

  @keyframes mural-deriva-3 {
    from {
      transform: translateY(4%);
    }
    to {
      transform: translateY(-4%);
    }
  }

  @keyframes mural-sobe {
    from {
      opacity: 0;
      translate: 0 24px;
    }
  }

  @media (min-width: 100rem) and (min-height: 50rem) {
    .mural {
      --altura: min(56rem, 72vh);
    }
  }
</style>
